# Copy this file to .env and change the values. Never commit .env to GitHub.

# Port for local runs (Render sets PORT itself).
PORT=3000

# Local SQLite file:
DATABASE_URL=file:records.db
# Hosted SQLite (Turso), used on Render so records survive restarts:
# DATABASE_URL=libsql://your-database-name.turso.io
# DATABASE_AUTH_TOKEN=paste-your-turso-token-here

# Browser origins allowed to read the API (comma-separated, no final slash).
# 5500 = VS Code Live Server. Add your Netlify site in Activity 8.
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
